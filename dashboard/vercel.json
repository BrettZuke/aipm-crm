{
  "crons": [
    {
      "path": "/api/send",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/sequences?tick=1",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/sequences?tick=1&track=coach",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/digest?slot=uk",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/digest?slot=ny",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/digest?slot=la",
      "schedule": "0 15 * * *"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/crm-close"
    },
    {
      "source": "/go/:code",
      "destination": "/api/go?c=:code"
    }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
